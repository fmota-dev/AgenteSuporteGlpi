@{
    var (classes, texto) = ObterEstilo(Status);
}

<span class="@classes">@texto</span>

@code {
    [Parameter] public string Status { get; set; } = string.Empty;

    private static (string classes, string texto) ObterEstilo(string? status)
    {
        var normalizado = status?.Trim() ?? string.Empty;

        return normalizado switch
        {
            "Novo" => ("inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700", "Novo"),
            "EmAtendimento" => ("inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700", "Em atendimento"),
            "Pendente" => ("inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700", "Pendente"),
            "Solucionado" => ("inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700", "Solucionado"),
            "Fechado" => ("inline-flex rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700", "Fechado"),
            "Ativo" => ("inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700", "Ativo"),
            "Bloqueado" => ("inline-flex rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700", "Bloqueado"),
            "Inativo" => ("inline-flex rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700", "Inativo"),
            _ => ("inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600", normalizado)
        };
    }
}
