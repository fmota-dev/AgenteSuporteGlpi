<nav class="space-y-2">
    <NavLink href="/dashboard"
             Match="NavLinkMatch.All"
             class="@ObterClasseLink()"
             ActiveClass="bg-[#003E7A] text-white shadow-lg"
             title="Dashboard"
             @onclick="AoSelecionarItem">
        <span class="material-symbols-rounded nav-icon" aria-hidden="true">dashboard</span>
        <span class="@ObterClasseTexto()">Dashboard</span>
    </NavLink>

    <NavLink href="/chamados"
             class="@ObterClasseLink()"
             ActiveClass="bg-[#003E7A] text-white shadow-lg"
             title="Chamados"
             @onclick="AoSelecionarItem">
        <span class="material-symbols-rounded nav-icon" aria-hidden="true">support</span>
        <span class="@ObterClasseTexto()">Chamados</span>
    </NavLink>

    <NavLink href="/analises"
             class="@ObterClasseLink()"
             ActiveClass="bg-[#003E7A] text-white shadow-lg"
             title="Analises IA"
             @onclick="AoSelecionarItem">
        <span class="material-symbols-rounded nav-icon" aria-hidden="true">psychology</span>
        <span class="@ObterClasseTexto()">Analises IA</span>
    </NavLink>

    <div class="border-t border-[#003E7A]/30 my-2"></div>

    <NavLink href="/executar"
             class="@ObterClasseLink()"
             ActiveClass="bg-[#003E7A] text-white shadow-lg"
             title="Executar Pipeline"
             @onclick="AoSelecionarItem">
        <span class="material-symbols-rounded nav-icon" aria-hidden="true">play_arrow</span>
        <span class="@ObterClasseTexto()">Executar</span>
    </NavLink>
</nav>

@code {
    [Parameter] public bool MenuRecolhido { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> AoSelecionarItem { get; set; }

    private string ObterClasseLink()
        => MenuRecolhido
            ? "group flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium text-blue-50 transition hover:bg-[#003E7A]/80 hover:text-white lg:justify-center lg:px-0"
            : "group flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-medium text-blue-50 transition hover:bg-[#003E7A]/80 hover:text-white";

    private string ObterClasseTexto()
        => MenuRecolhido ? "lg:hidden" : "truncate";
}
