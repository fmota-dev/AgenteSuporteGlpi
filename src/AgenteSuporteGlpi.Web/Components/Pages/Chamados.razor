@page "/chamados"
@page "/chamados/{Numero:int}"
@rendermode InteractiveServer
@inject ServicoDashboard Dashboard
@inject NavigationManager Nav

@if (Numero > 0)
{
    <PageTitle>#@Numero — Chamado</PageTitle>

    @if (_detalhe is null)
    {
        <LoadingSpinner />
    }
    else
    {
        var titulo = $"#{_detalhe.Numero} — {_detalhe.Titulo}";
        <PageHeader Titulo="@titulo" />

        <nav class="flex mb-5 text-sm text-slate-500" aria-label="Breadcrumb">
            <a href="/chamados" class="hover:text-blue-700 transition">Chamados</a>
            <span class="mx-2">/</span>
            <span class="text-slate-900 font-medium">#@_detalhe.Numero</span>
        </nav>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="md:col-span-2 bg-white rounded-2xl shadow-sm p-5">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">@_detalhe.Titulo</h2>
                    </div>
                    <a href="@_detalhe.Link" target="_blank" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-700 hover:bg-blue-50 px-3 py-1.5 rounded-xl transition">
                        <span class="material-symbols-rounded text-base">open_in_new</span>
                        GLPI
                    </a>
                </div>
                <dl class="grid grid-cols-2 gap-4 text-sm">
                    <div><dt class="text-slate-500 text-xs uppercase">Status</dt><dd class="mt-1"><StatusBadge Status="@_detalhe.Status" /></dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Prioridade</dt><dd class="mt-1 font-medium">@_detalhe.Prioridade</dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Responsavel</dt><dd class="mt-1 font-medium">@_detalhe.Responsavel</dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Solicitante</dt><dd class="mt-1 font-medium">@(_detalhe.Solicitante ?? "-")</dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Categoria</dt><dd class="mt-1 font-medium">@(_detalhe.Categoria ?? "-")</dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Coletas</dt><dd class="mt-1 font-medium">@_detalhe.TotalColetas</dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Abertura</dt><dd class="mt-1 font-medium">@FormatarData(_detalhe.DataAbertura)</dd></div>
                    <div><dt class="text-slate-500 text-xs uppercase">Ult. Atualizacao</dt><dd class="mt-1 font-medium">@FormatarData(_detalhe.DataUltimaAtualizacao)</dd></div>
                </dl>
            </div>

            <div class="space-y-5">
                <div class="bg-white rounded-2xl shadow-sm p-5">
                    <h3 class="text-sm font-semibold text-slate-500 uppercase mb-3">Identificacao</h3>
                    <p class="text-lg font-bold @CorConfianca(_detalhe.Confianca)">@_detalhe.Sistema</p>
                    <p class="text-sm text-slate-500">@_detalhe.Confianca (@_detalhe.Pontuacao pts)</p>
                    <p class="text-xs text-slate-400 mt-1">Termos: @_detalhe.TermosEncontrados</p>
                </div>

                @if (_detalhe.ResumoTecnicoIa is not null)
                {
                    <div class="bg-white rounded-2xl shadow-sm p-5">
                        <h3 class="text-sm font-semibold text-slate-500 uppercase mb-3">Analise IA</h3>
                        <p class="text-sm text-slate-700 mb-3">@_detalhe.ResumoTecnicoIa</p>
                        @if (!string.IsNullOrWhiteSpace(_detalhe.PerguntasIa))
                        {
                            <p class="text-xs font-semibold text-slate-500 uppercase mb-1">Perguntas</p>
                            <ul class="text-xs text-slate-600 list-disc list-inside space-y-0.5 mb-3">
                                @foreach (var p in _detalhe.PerguntasIa.Split("|||", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li>@p.Trim()</li>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detalhe.ProximosPassosIa))
                        {
                            <p class="text-xs font-semibold text-slate-500 uppercase mb-1">Proximos Passos</p>
                            <ul class="text-xs text-slate-600 list-disc list-inside space-y-0.5">
                                @foreach (var p in _detalhe.ProximosPassosIa.Split("|||", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li>@p.Trim()</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <PageTitle>Chamados — Agente Suporte GLPI</PageTitle>
    <PageHeader Titulo="Chamados" />

    @if (_sistemas.Count > 0)
    {
        <div class="flex flex-wrap gap-2 mb-5">
            <button @onclick="() => SelecionarSistema(null)"
                    class="px-4 py-1.5 rounded-xl text-sm font-medium transition @(string.IsNullOrEmpty(_filtroSistema) ? "bg-blue-700 text-white" : "bg-white text-slate-600 hover:bg-slate-100")">
                Todos
            </button>
            @foreach (var s in _sistemas)
            {
                <button @onclick="() => SelecionarSistema(s)"
                        class="px-4 py-1.5 rounded-xl text-sm font-medium transition @(_filtroSistema == s ? "bg-blue-700 text-white" : "bg-white text-slate-600 hover:bg-slate-100")">
                    @s
                </button>
            }
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-slate-50 text-slate-600 uppercase text-xs">
                    <tr>
                        <th class="px-5 py-3">#</th>
                        <th class="px-5 py-3">Titulo</th>
                        <th class="px-5 py-3">Status</th>
                        <th class="px-5 py-3">Sistema</th>
                        <th class="px-5 py-3">Confianca</th>
                        <th class="px-5 py-3">Coletas</th>
                        <th class="px-5 py-3">Ultima Coleta</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var c in _chamados)
                    {
                        <tr class="hover:bg-slate-50 cursor-pointer transition" @onclick="() => IrChamado(c.Numero)">
                            <td class="px-5 py-3">
                                <a href="@c.Link" target="_blank" class="text-blue-700 hover:underline font-medium" @onclick:stopPropagation="true">#@c.Numero</a>
                            </td>
                            <td class="px-5 py-3 max-w-sm truncate">@c.Titulo</td>
                            <td class="px-5 py-3"><StatusBadge Status="@c.Status" /></td>
                            <td class="px-5 py-3 font-medium @CorConfianca(c.Confianca)">@c.Sistema</td>
                            <td class="px-5 py-3">@c.Confianca</td>
                            <td class="px-5 py-3">@c.TotalColetas</td>
                            <td class="px-5 py-3 whitespace-nowrap text-xs">@FormatarData(c.UltimaColeta ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int Numero { get; set; }

    private List<ChamadoDetalheViewModel> _chamados = [];
    private ChamadoDetalheViewModel? _detalhe;
    private List<string> _sistemas = [];
    private string? _filtroSistema;

    protected override async Task OnInitializedAsync()
    {
        if (Numero > 0)
            _detalhe = await Dashboard.ObterChamadoAsync(Numero);
        else
        {
            _sistemas = await Dashboard.ListarSistemasAsync();
            _chamados = await Dashboard.ListarChamadosAsync();
        }
    }

    private async Task SelecionarSistema(string? sistema)
    {
        _filtroSistema = sistema;
        _chamados = await Dashboard.ListarChamadosAsync(sistema);
    }

    private void IrChamado(int numero)
        => Nav.NavigateTo($"/chamados/{numero}");

    private static string CorConfianca(string confianca) => confianca switch
    {
        "Alta" => "text-emerald-600",
        "Media" => "text-amber-500",
        "Baixa" => "text-red-500",
        _ => "text-slate-400"
    };

    private static string FormatarData(string dataIso)
    {
        if (DateTimeOffset.TryParse(dataIso, out var d))
            return d.LocalDateTime.ToString("dd/MM/yyyy HH:mm");
        return dataIso;
    }
}
