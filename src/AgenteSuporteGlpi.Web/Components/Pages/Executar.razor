@page "/executar"
@rendermode InteractiveServer
@inject ServicoPipeline Pipeline
@implements IDisposable

<PageTitle>Executar — Agente Suporte GLPI</PageTitle>
<PageHeader Titulo="Executar Pipeline" />

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
    <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-rounded text-2xl text-blue-600">cloud_download</span>
            <div>
                <h3 class="font-bold text-slate-900">Coleta GLPI</h3>
                <p class="text-xs text-slate-500">Busca chamados da central, identifica sistema e persiste no SQLite.</p>
            </div>
        </div>
        <button @onclick="DispararColetaAsync"
                disabled="@Pipeline.Executando"
                class="w-full px-4 py-2.5 rounded-xl text-sm font-semibold transition @(Pipeline.Executando ? "bg-slate-200 text-slate-400 cursor-not-allowed" : "bg-blue-700 text-white hover:bg-blue-800")">
            @if (_modoAtual == "Coleta" && Pipeline.Executando)
            {
                <span class="inline-flex items-center gap-2">
                    <span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    Executando...
                </span>
            }
            else
            {
                <span>Executar Coleta</span>
            }
        </button>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex items-center gap-3 mb-4">
            <span class="material-symbols-rounded text-2xl text-purple-600">psychology</span>
            <div>
                <h3 class="font-bold text-slate-900">Analise IA</h3>
                <p class="text-xs text-slate-500">Consulta SQLite, enriquece com SQL Server e DevOps, analisa com Ollama.</p>
            </div>
        </div>
        <button @onclick="DispararAnaliseAsync"
                disabled="@Pipeline.Executando"
                class="w-full px-4 py-2.5 rounded-xl text-sm font-semibold transition @(Pipeline.Executando ? "bg-slate-200 text-slate-400 cursor-not-allowed" : "bg-purple-700 text-white hover:bg-purple-800")">
            @if (_modoAtual == "AnaliseIA" && Pipeline.Executando)
            {
                <span class="inline-flex items-center gap-2">
                    <span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    Executando...
                </span>
            }
            else
            {
                <span>Executar Analise IA</span>
            }
        </button>
    </div>
</div>

@if (_emExecucao)
{
    <div class="rounded-2xl p-4 mb-5 flex items-center gap-3 @(_status.Contains("concluida") ? "bg-emerald-50 border border-emerald-200" : "bg-blue-50 border border-blue-200")">
        @if (_status.Contains("em andamento") || _status.Contains("iniciando"))
        {
            <span class="inline-block w-4 h-4 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></span>
        }
        else
        {
            <span class="material-symbols-rounded text-lg @(_status.Contains("sucesso") ? "text-emerald-600" : "text-slate-500")">@(_status.Contains("sucesso") ? "check_circle" : "info")</span>
        }
        <p class="text-sm font-medium @(_status.Contains("concluida") ? "text-emerald-800" : "text-blue-800")">@_status</p>
    </div>
}

@if (_linhas.Count > 0)
{
    <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        @foreach (var (icone, cor, texto) in _linhas)
        {
            <div class="flex items-start gap-3 px-5 py-2.5 text-sm border-b border-slate-100 last:border-b-0">
                <span class="material-symbols-rounded text-base mt-0.5 @cor">@icone</span>
                <span class="text-slate-700">@texto</span>
            </div>
        }
    </div>
}

@code {
    private string? _modoAtual;
    private string _status = "";
    private bool _emExecucao;
    private readonly List<(string Icone, string Cor, string Texto)> _linhas = [];
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        if (Pipeline.Executando)
            _ = PollAsync(_cts = new CancellationTokenSource());
    }

    private async Task PollAsync(CancellationTokenSource cts)
    {
        var visto = 0;
        while (!cts.Token.IsCancellationRequested)
        {
            var log = Pipeline.Log.ToList();
            for (var i = visto; i < log.Count; i++)
            {
                var (icone, cor, texto) = TratarLinha(log[i]);
                _linhas.Add((icone, cor, texto));
            }
            visto = log.Count;

            _status = Pipeline.Executando ? $"{_modoAtual} em andamento..." : "";
            await InvokeAsync(StateHasChanged);

            if (!Pipeline.Executando)
            {
                if (_linhas.Count > 0)
                {
                    var ultima = _linhas.Last();
                    _status = ultima.Texto.Contains("concluida") ? $"{_modoAtual} concluida com sucesso." : $"{_modoAtual} finalizada.";
                }
                _modoAtual = null;
                await InvokeAsync(StateHasChanged);
                break;
            }

            await Task.Delay(500, cts.Token);
        }
    }

    private async Task DispararColetaAsync()
    {
        if (Pipeline.Executando) return;
        _modoAtual = "Coleta";
        _linhas.Clear();
        _status = "Coleta iniciando...";
        _emExecucao = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        _ = ExecutarPipelineAsync(Pipeline.ExecutarColetaAsync, _cts);
    }

    private async Task DispararAnaliseAsync()
    {
        if (Pipeline.Executando) return;
        _modoAtual = "AnaliseIA";
        _linhas.Clear();
        _status = "Analise IA iniciando...";
        _emExecucao = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        _ = ExecutarPipelineAsync(Pipeline.ExecutarAnaliseAsync, _cts);
    }

    private async Task ExecutarPipelineAsync(Func<Task> pipeline, CancellationTokenSource cts)
    {
        _ = Task.Run(async () =>
        {
            try { await pipeline(); }
            catch { }
        });

        _ = PollAsync(cts);
    }

    private static (string Icone, string Cor, string Texto) TratarLinha(string linha)
    {
        if (linha.StartsWith("[ERRO]"))
            return ("error", "text-red-500", linha[6..].TrimStart());

        var limpo = linha.TrimStart();

        if (limpo.StartsWith("==="))
            return ("bolt", "text-blue-600", limpo.TrimStart('=', ' '));

        if (limpo.Contains("NOVO"))
            return ("fiber_new", "text-emerald-600", limpo);

        if (limpo.Contains("ALTERADO"))
            return ("edit", "text-amber-500", limpo);

        if (limpo.Contains("sem alteracoes"))
            return ("check", "text-slate-400", limpo);

        if (limpo.Contains("ERRO:"))
            return ("error", "text-red-500", limpo);

        if (limpo.StartsWith("IA:"))
            return ("psychology", "text-purple-600", limpo);

        if (limpo.Contains("concluida"))
            return ("check_circle", "text-emerald-600", limpo);

        if (limpo.Contains("FALHA:"))
            return ("cancel", "text-red-500", limpo);

        if (limpo.StartsWith("Chamados encontrados") || limpo.StartsWith("Chamados elegiveis"))
            return ("search", "text-slate-500", limpo);

        return ("", "text-slate-500", limpo);
    }

    public void Dispose()
        => _cts?.Cancel();
}
